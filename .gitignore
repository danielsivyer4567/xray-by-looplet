__pycache__/
*.pyc
.pytest_cache/
out/
verify_tmp/
_to_delete/
*.marked.pdf
takeoff.json

# secrets — NEVER commit (signing keys, API keys, supplier credentials).
# Defensive: these are already untracked, but listing them prevents an
# accidental `git add` from ever leaking a key into a private-but-shared repo.
keys/
.env
*.env
!.env.example
*.pem
*.jwk
*.p12
*.pfx
*.key

# salvage/quarantine folder used when recovering from git lock or branch mishaps
_to_delete/

# Supplier pricing is commercially sensitive and dates fast: the IMPORTER is
# version-controlled, the prices are not. Regenerate from the source PDF.
pricing/out/
*-catalogue.json
*-catalogue.csv
