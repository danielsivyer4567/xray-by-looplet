{
  "name": "xray-desktop",
  "version": "0.1.0",
  "description": "X-Ray by Looplet - construction takeoff desktop app (engine + CAD Studio, fully offline)",
  "author": "Looplet",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "build:engine": "node -e \"console.log('run scripts/build-engine.ps1 (Windows) or scripts/build-engine.sh first')\""
  },
  "dependencies": {
    "@looplet/xray-host": "file:../host"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.looplet.xray",
    "productName": "X-Ray by Looplet",
    "files": ["main.js", "preload.js", "renderer/**/*"],
    "extraResources": [
      { "from": "engine/bin/", "to": "engine/", "filter": ["**/*"] }
    ],
    "win": { "target": ["nsis"], "artifactName": "XRay-Setup-${version}.${ext}" },
    "mac": { "target": ["dmg"] },
    "linux": { "target": ["AppImage"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
