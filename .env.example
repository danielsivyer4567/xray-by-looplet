# X-Ray takeoff worker — public-API configuration.
# Copy to `.env` (gitignored) and set for a public deployment. All optional:
# UNSET values keep today's open local-dev behaviour exactly.

# --- auth / metering -------------------------------------------------------
# Comma-separated API keys. Unset = OPEN mode (no key required, local dev).
# Set for public: XRAY_API_KEYS=xr_live_abc123,xr_live_def456
XRAY_API_KEYS=

# --- upload guardrails -----------------------------------------------------
XRAY_MAX_UPLOAD_MB=50          # reject larger uploads with 413
XRAY_PARSE_TIMEOUT_S=60        # kill a parse that runs longer (isolated mode)
XRAY_ISOLATE_PARSE=0           # 1 = run each parse in a disposable child process
XRAY_CACHE_SIZE=64             # sha256->result LRU entries (idempotency cache)

# NOTE: the engine itself makes NO network calls. Pricing / supplier lookups
# (Bunnings PowerPass, Sonar) live in a SEPARATE service with its own keys,
# stored on the user's machine — never here, never in the repo.
